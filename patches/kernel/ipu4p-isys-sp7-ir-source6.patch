+/*
+ * Surface Pro 7 IR camera (ov7251 on CSI-2 index 1 = firmware source 6, one
+ * lane) bring-up switches. Everything here is scoped to source 6 and, apart
+ * from the statistics line, off by default, so the RGB cameras are untouched.
+ * PHY building block 8 is the IR lane; Linux never configures it, and without
+ * it the receiver sees no HS traffic at all. The values are the "Table B"
+ * candidate from an earlier public SP7 IPU4 camera write-up. BB8 writes persist until
+ * reboot (an isys reload or power cycle does not restore them).
+ */
+static bool sp7_ir_bb8;
+module_param(sp7_ir_bb8, bool, 0644);
+MODULE_PARM_DESC(sp7_ir_bb8, "SP7 IR: program PHY building block 8 at source-6 stream start");
+
+static uint sp7_ir_bb8_afe = 0x44104015;
+module_param(sp7_ir_bb8_afe, uint, 0644);
+MODULE_PARM_DESC(sp7_ir_bb8_afe, "SP7 IR: BB8 AFE config value");
+
+static int sp7_ir_bb8_crc = 13;
+module_param(sp7_ir_bb8_crc, int, 0644);
+MODULE_PARM_DESC(sp7_ir_bb8_crc, "SP7 IR: BB8 CPHY DLL override field");
+
+static int sp7_ir_bb8_drc = 32;
+module_param(sp7_ir_bb8_drc, int, 0644);
+MODULE_PARM_DESC(sp7_ir_bb8_drc, "SP7 IR: BB8 DPHY DLL override field");
+
+static int sp7_ir_bb8_dll = 3;
+module_param(sp7_ir_bb8_dll, int, 0644);
+MODULE_PARM_DESC(sp7_ir_bb8_dll, "SP7 IR: BB8 DLL override enables, bit0 CPHY, bit1 DPHY (clear = hardware DLL)");
+
+int sp7_ir_verify_ticks = 12;
+module_param(sp7_ir_verify_ticks, int, 0644);
+MODULE_PARM_DESC(sp7_ir_verify_ticks, "SP7 IR: 50 ms ticks to wait for a frame before each bounce (source 6)");
+
+static int sp7_ir_bad_errs = 2;
+module_param(sp7_ir_bad_errs, int, 0644);
+MODULE_PARM_DESC(sp7_ir_bad_errs, "SP7 IR: packet header/CRC/incomplete-packet error events tolerated in the qualification window (-1 = no check)");
+
+int sp7_ir_qual_ms = 150;
+module_param(sp7_ir_qual_ms, int, 0644);
+MODULE_PARM_DESC(sp7_ir_qual_ms, "SP7 IR: link qualification window after the first frame of a (re)start");
+
+int sp7_ir_qual_frames = 2;
+module_param(sp7_ir_qual_frames, int, 0644);
+MODULE_PARM_DESC(sp7_ir_qual_frames, "SP7 IR: error-free frames required within the qualification window");
+
+/*
+ * The JSL PHY code (same PHY family) also sets cphy_rx_control1.en_crc1 and
+ * dphy_cfg.lden_from_dll_ovrd_0. On the SP7 IR lane they make frames flow
+ * from dirty link locks too (thousands of CRC errors), so they stay off;
+ * kept as a switch for experiments. Limited to building block 8.
+ */
+static bool sp7_ir_bb8_jsl;
+module_param(sp7_ir_bb8_jsl, bool, 0644);
+MODULE_PARM_DESC(sp7_ir_bb8_jsl, "SP7 IR: set the JSL-style DLL load-enable bits on building block 8");
+
+int sp7_ir_verify_retries = 30;
+module_param(sp7_ir_verify_retries, int, 0644);
+MODULE_PARM_DESC(sp7_ir_verify_retries, "SP7 IR: sensor bounces at stream start before giving up (source 6)");
+
+static int sp7_ir_ctermen = -1, sp7_ir_csettle = -1;
+static int sp7_ir_dtermen = -1, sp7_ir_dsettle = -1;
+module_param(sp7_ir_ctermen, int, 0644);
+module_param(sp7_ir_csettle, int, 0644);
+module_param(sp7_ir_dtermen, int, 0644);
+module_param(sp7_ir_dsettle, int, 0644);
+MODULE_PARM_DESC(sp7_ir_dsettle, "SP7 IR: source-6 receiver delay counter overrides (-1 = calculated)");
+
+/*
+ * On IPU4P the receiver delay registers sit one slot later than this driver's
+ * TERMEN/SETTLE names say (see the front timing quirk above): 0x30 is the
+ * clock-lane termen, 0x34 the clock-lane settle, then termen/settle pairs per
+ * data lane from 0x38. The generic path therefore leaves the real clock settle
+ * at 0 and never writes the real data settle. These write the Windows layout
+ * on source 6 (-1 = generic path); ticks are 1/8 ns.
+ */
+static int sp7_ir_win_cs = -1;
+module_param(sp7_ir_win_cs, int, 0644);
+MODULE_PARM_DESC(sp7_ir_win_cs, "SP7 IR: clock-lane settle ticks, written in the IPU4P register layout (-1 = generic path)");
+
+static int sp7_ir_win_ds = 1269;
+module_param(sp7_ir_win_ds, int, 0644);
+MODULE_PARM_DESC(sp7_ir_win_ds, "SP7 IR: data-lane settle ticks, used with sp7_ir_win_cs");
+
+static bool sp7_ir_lanes_first;
+module_param(sp7_ir_lanes_first, bool, 0644);
+MODULE_PARM_DESC(sp7_ir_lanes_first, "SP7 IR: program the lane count before RX_CONFIG on source 6");
+
+static int sp7_ir_afe_off_us = 150;
+module_param(sp7_ir_afe_off_us, int, 0644);
+MODULE_PARM_DESC(sp7_ir_afe_off_us, "SP7 IR: how long the BB8 AFE stays off when cycled");
+
+static int sp7_ir_afe_settle_us;
+module_param(sp7_ir_afe_settle_us, int, 0644);
+MODULE_PARM_DESC(sp7_ir_afe_settle_us, "SP7 IR: delay after (re)enabling the BB8 AFE, before the sensor starts HS");
+
+static int sp7_ir_rearm;
+module_param(sp7_ir_rearm, int, 0644);
+MODULE_PARM_DESC(sp7_ir_rearm, "SP7 IR: on each sensor bounce re-arm the receiver: 1 rewrite BB8, 2 also cycle RX enable, 3 also toggle the DLL overrides, 4 also power-cycle the BB8 AFE, 5 restart the whole CSI-2 receiver instead");
+
+static bool sp7_ir_stats = true;
+module_param(sp7_ir_stats, bool, 0644);
+MODULE_PARM_DESC(sp7_ir_stats, "SP7 IR: log source-6 receiver state and status-bit counts at stream start/stop");
+
+static u32 sp7_ir_irqs, sp7_ir_bits[18];
+
+static bool sp7_ir_source(struct ipu_isys_csi2 *csi2)
+{
+	return csi2->asd.source == IPU_FW_ISYS_STREAM_SRC_CSI2_PORT0 + 6;
+}
+
+static void sp7_ir_bb8_write(struct ipu_isys_csi2 *csi2, bool toggle)
+{
+	void __iomem *isp_base = csi2->isys->adev->isp->base;
+	u32 c, d;
+
+	c = (readl(isp_base + BUTTRESS_REG_CPHYX_DLL_OVRD(8)) & ~0x7f) |
+	    ((sp7_ir_bb8_crc & 0x3f) << 1);
+	d = (readl(isp_base + BUTTRESS_REG_DPHYX_DLL_OVRD(8)) & ~0x7f) |
+	    ((sp7_ir_bb8_drc & 0x3f) << 1);
+	if (toggle) {
+		writel(c, isp_base + BUTTRESS_REG_CPHYX_DLL_OVRD(8));
+		writel(d, isp_base + BUTTRESS_REG_DPHYX_DLL_OVRD(8));
+		usleep_range(10, 20);
+	}
+	writel(c | (sp7_ir_bb8_dll & 1), isp_base + BUTTRESS_REG_CPHYX_DLL_OVRD(8));
+	writel(d | !!(sp7_ir_bb8_dll & 2), isp_base + BUTTRESS_REG_DPHYX_DLL_OVRD(8));
+	writel(sp7_ir_bb8_afe, isp_base + BUTTRESS_REG_BBX_AFE_CONFIG(8));
+	if (sp7_ir_afe_settle_us > 0)
+		usleep_range(sp7_ir_afe_settle_us, sp7_ir_afe_settle_us + 100);
+}
+
+/*
+ * A bad IR link lock still lets frames through (corrupt data the firmware
+ * reports as good), which would end the start-up verification. A good lock
+ * shows no packet header, CRC or incomplete-packet errors at all; a bad one
+ * hundreds per second. Returns true if any showed up since the last call.
+ */
+bool ipu_isys_csi2_sp7_link_bad(struct ipu_isys_csi2 *csi2)
+{
+	static u32 last_hdrn;
+	u32 now, delta;
+
+	if (!sp7_ir_source(csi2) || sp7_ir_bad_errs < 0)
+		return false;
+	now = sp7_ir_bits[0] + sp7_ir_bits[1] + sp7_ir_bits[2] + sp7_ir_bits[6];
+	delta = now - last_hdrn;
+	last_hdrn = now;
+	return delta > sp7_ir_bad_errs;
+}
+
+/* True if a bounce should restart the whole receiver (set_stream off/on) */
+bool ipu_isys_csi2_sp7_deep(struct ipu_isys_csi2 *csi2)
+{
+	return sp7_ir_source(csi2) && sp7_ir_bb8 && sp7_ir_rearm >= 5;
+}
+
+/* Called between the sensor's s_stream(0) and s_stream(1) when bouncing */
+void ipu_isys_csi2_sp7_rearm(struct ipu_isys_csi2 *csi2)
+{
+	if (!sp7_ir_source(csi2) || !sp7_ir_bb8 || sp7_ir_rearm <= 0 ||
+	    sp7_ir_rearm >= 5)
+		return;
+	if (sp7_ir_rearm >= 2)
+		writel(0, csi2->base + CSI2_REG_CSI_RX_ENABLE);
+	if (sp7_ir_rearm >= 4) {
+		writel(0, csi2->isys->adev->isp->base +
+		       BUTTRESS_REG_BBX_AFE_CONFIG(8));
+		usleep_range(sp7_ir_afe_off_us, sp7_ir_afe_off_us + 50);
+	}
+	sp7_ir_bb8_write(csi2, sp7_ir_rearm >= 3);
+	if (sp7_ir_rearm >= 2) {
+		usleep_range(50, 100);
+		writel(CSI2_CSI_RX_ENABLE_ENABLE,
+		       csi2->base + CSI2_REG_CSI_RX_ENABLE);
+	}
+}
+
+static void sp7_ir_bb8_init(struct ipu_isys_csi2 *csi2)
+{
+	void __iomem *isp_base = csi2->isys->adev->isp->base;
+	u32 c0, d0, a0, val;
+
+	c0 = readl(isp_base + BUTTRESS_REG_CPHYX_DLL_OVRD(8));
+	d0 = readl(isp_base + BUTTRESS_REG_DPHYX_DLL_OVRD(8));
+	a0 = readl(isp_base + BUTTRESS_REG_BBX_AFE_CONFIG(8));
+
+	val = (c0 & ~0x7f) | ((sp7_ir_bb8_crc & 0x3f) << 1) | (sp7_ir_bb8_dll & 1);
+	writel(val, isp_base + BUTTRESS_REG_CPHYX_DLL_OVRD(8));
+	val = (d0 & ~0x7f) | ((sp7_ir_bb8_drc & 0x3f) << 1) | !!(sp7_ir_bb8_dll & 2);
+	writel(val, isp_base + BUTTRESS_REG_DPHYX_DLL_OVRD(8));
+	if (sp7_ir_rearm >= 4) {
+		/* The AFE value is sticky; cycle it so it calibrates afresh */
+		writel(0, isp_base + BUTTRESS_REG_BBX_AFE_CONFIG(8));
+		usleep_range(sp7_ir_afe_off_us, sp7_ir_afe_off_us + 50);
+	}
+	writel(sp7_ir_bb8_afe, isp_base + BUTTRESS_REG_BBX_AFE_CONFIG(8));
+	if (sp7_ir_afe_settle_us > 0)
+		usleep_range(sp7_ir_afe_settle_us, sp7_ir_afe_settle_us + 100);
+
+	/* Set or clear explicitly: these bits survive isys power cycles */
+	val = readl(isp_base + BUTTRESS_REG_CPHYX_RX_CONTROL1(8));
+	val = sp7_ir_bb8_jsl ? val | BIT(31) : val & ~BIT(31);
+	writel(val, isp_base + BUTTRESS_REG_CPHYX_RX_CONTROL1(8));
+	/* DPHY_CFG sits 4 bytes below DPHY_DLL_OVRD */
+	val = readl(isp_base + BUTTRESS_REG_DPHYX_DLL_OVRD(8) - 4);
+	val = sp7_ir_bb8_jsl ? val | BIT(25) | BIT(26) :
+			       val & ~(BIT(25) | BIT(26));
+	writel(val, isp_base + BUTTRESS_REG_DPHYX_DLL_OVRD(8) - 4);
+
+	dev_info(&csi2->isys->adev->dev,
+		 "sp7-ir: BB8 before=(0x%x,0x%x,0x%x) after=(0x%x,0x%x,0x%x)\n",
+		 c0, d0, a0,
+		 readl(isp_base + BUTTRESS_REG_CPHYX_DLL_OVRD(8)),
+		 readl(isp_base + BUTTRESS_REG_DPHYX_DLL_OVRD(8)),
+		 readl(isp_base + BUTTRESS_REG_BBX_AFE_CONFIG(8)));
+}
+
+static void sp7_ir_log(struct ipu_isys_csi2 *csi2, const char *tag)
+{
+	dev_info(&csi2->isys->adev->dev,
+		 "sp7-ir csi %u %s: en=%u lanes=%u cfg=0x%x status=0x%x hs=0x%x lp=0x%x ct=%u cs=%u dt=%u ds=%u | irqs=%u sof=%u eof=%u nonrec=%u rec=%u fsync=%u lsync=%u hdr1=%u hdrN=%u crc=%u fifo=%u incompl=%u ulps_exit=%u\n",
+		 csi2->index, tag,
+		 readl(csi2->base + CSI2_REG_CSI_RX_ENABLE),
+		 readl(csi2->base + CSI2_REG_CSI_RX_NOF_ENABLED_LANES),
+		 readl(csi2->base + CSI2_REG_CSI_RX_CONFIG),
+		 readl(csi2->base + CSI2_REG_CSI_RX_STATUS),
+		 readl(csi2->base + CSI2_REG_CSI_RX_STATUS_DLANE_HS),
+		 readl(csi2->base + CSI2_REG_CSI_RX_STATUS_DLANE_LP),
+		 readl(csi2->base + CSI2_REG_CSI_RX_DLY_CNT_TERMEN_CLANE),
+		 readl(csi2->base + CSI2_REG_CSI_RX_DLY_CNT_SETTLE_CLANE),
+		 readl(csi2->base + CSI2_REG_CSI_RX_DLY_CNT_TERMEN_DLANE(0)),
+		 readl(csi2->base + 0x3c),
+		 sp7_ir_irqs, sp7_ir_bits[16], sp7_ir_bits[17], sp7_ir_bits[10],
+		 sp7_ir_bits[9], sp7_ir_bits[7], sp7_ir_bits[8], sp7_ir_bits[0],
+		 sp7_ir_bits[1], sp7_ir_bits[2], sp7_ir_bits[3], sp7_ir_bits[6],
+		 sp7_ir_bits[14]);
+}
