diff --git a/drivers/hid/ipts/hid.c b/drivers/hid/ipts/hid.c
index e34a1a4..a3e1dd9 100644
--- a/drivers/hid/ipts/hid.c
+++ b/drivers/hid/ipts/hid.c
@@ -31,6 +31,56 @@ void ipts_hid_disable(struct ipts_context *ipts)
 	WRITE_ONCE(ipts->hid_active, false);
 }
 
+static void ipts_hid_exit(struct ipts_context *ipts)
+{
+	if (atomic_dec_and_test(&ipts->hid_users))
+		wake_up_all(&ipts->hid_users_wq);
+}
+
+/*
+ * Every HID callback that runs driver code is counted, so that stopping can
+ * wait until none of them can touch the buffers it is about to free.
+ */
+static bool ipts_hid_enter(struct ipts_context *ipts)
+{
+	atomic_inc(&ipts->hid_users);
+
+	/*
+	 * Pairs with the smp_mb() in ipts_hid_quiesce(): either quiesce sees
+	 * this caller in hid_users, or this caller sees hid_active cleared.
+	 */
+	smp_mb__after_atomic();
+
+	if (!READ_ONCE(ipts->hid_active)) {
+		ipts_hid_exit(ipts);
+		return false;
+	}
+
+	return true;
+}
+
+int ipts_hid_quiesce(struct ipts_context *ipts, unsigned int timeout_ms)
+{
+	ipts_hid_disable(ipts);
+
+	/*
+	 * Order clearing hid_active before reading hid_users. Pairs with the
+	 * smp_mb__after_atomic() in ipts_hid_enter().
+	 */
+	smp_mb();
+
+	/*
+	 * Release a GET_FEATURE request waiting for a reply that will not come.
+	 */
