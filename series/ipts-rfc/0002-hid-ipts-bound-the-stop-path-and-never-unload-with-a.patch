@@ -103,7 +103,10 @@ static inline int ipts_control_refill_buffer(struct ipts_context *ipts, u32 buff
  * ipts_control_start() - Initialized the device and starts the data flow.
  * @ipts: The IPTS driver context.
  *
- * Returns: 0 on success, <0 on error.
+ * On failure everything it set up is torn down again.
+ *
+ * Returns: 0 on success, -ETIMEDOUT if the teardown left the context wedged,
+ * <0 on other errors.
  */
