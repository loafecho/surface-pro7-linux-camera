+
+err_stop:
+	/*
+	 * The receiver is running: stop it before anything it uses goes away.
+	 * If it cannot be stopped, report that instead of the original error.
+	 */
+	if (ipts_control_stop(ipts) == -ETIMEDOUT)
+		return -ETIMEDOUT;
+
+	return ret;
+
+err_leak_resources:
+	/*
+	 * The device may already have been given these buffers and was never
+	 * told to stop, so they are never freed.
+	 */
+	dev_err(ipts->dev, "Leaking DMA buffers after a failed start\n");
+	memset(&ipts->resources, 0, sizeof(ipts->resources));
+	return ret;
+
+err_free_resources:
+	ipts_resources_free(&ipts->resources);
+	return ret;
 }
 
+/*
+ * How long stopping waits for running HID callbacks. The longest one is a
+ * GET_FEATURE request (5 s), which ipts_hid_quiesce() also cuts short.
+ */
+#define IPTS_HID_QUIESCE_TIMEOUT_MS 10000
+
 static int _ipts_control_stop(struct ipts_context *ipts)
 {
 	int ret = 0;
@@ -430,20 +459,59 @@ static int _ipts_control_stop(struct ipts_context *ipts)
 	if (!ipts)
 		return -EFAULT;
 
-	ipts_hid_disable(ipts);
 	dev_info(ipts->dev, "Stopping IPTS\n");
 
+	if (!ipts->callers_stuck && ipts_hid_quiesce(ipts, IPTS_HID_QUIESCE_TIMEOUT_MS)) {
+		ipts->callers_stuck = true;
+		dev_err(ipts->dev, "A HID request never returned (%d still running)\n",
+			atomic_read(&ipts->hid_users));
+	}
+
 	ret = ipts_receiver_stop(ipts);
-	if (ret) {
+	if (ret == -EOWNERDEAD) {
+		/*
+		 * It may have died inside HID or input core holding their locks,
+		 * so the HID device cannot be destroyed safely either.
+		 */
+		ipts->wedged = true;
+		dev_err(ipts->dev, "Receiver thread died without stopping\n");
+	} else if (ret == -ETIMEDOUT) {
+		ipts->wedged = true;
+		dev_err(ipts->dev, "Receiver thread did not stop within %d ms\n",
+			IPTS_THREAD_STOP_TIMEOUT_MS);
+	} else if (ret) {
 		dev_err(ipts->dev, "Failed to stop receiver: %d\n", ret);
-		return ret;
+	} else if (ipts->receiver_loop.exit_code && !ipts->leak_buffers) {
+		ipts->leak_buffers = true;
+		dev_err(ipts->dev, "Device did not confirm the stop (%d), leaking its DMA buffers\n",
+			ipts->receiver_loop.exit_code);
+	}
+
+	/*
+	 * Never free buffers that a stuck thread or a stuck HID request can
+	 * still read or write. They are leaked on purpose.
+	 */
+	if (ipts->wedged || ipts->callers_stuck)
+		return -ETIMEDOUT;
+
+	/*
+	 * Without the message lock the flush handshake could not be confirmed,
+	 * so the device may still be writing to the buffers.
+	 */
+	if (READ_ONCE(ipts->mei.lock_lost) && !ipts->leak_buffers) {
+		ipts->leak_buffers = true;
+		dev_err(ipts->dev, "Device stop not confirmed, leaking its DMA buffers\n");
+	}
+
+	if (ipts->leak_buffers) {
+		memset(&ipts->resources, 0, sizeof(ipts->resources));
+		ipts->leak_buffers = false;
+		return 0;
 	}
 
 	ret = ipts_resources_free(&ipts->resources);
-	if (ret) {
+	if (ret)
 		dev_err(ipts->dev, "Failed to free resources: %d\n", ret);
-		return ret;
-	}
 
 	return 0;
 }
@@ -452,26 +520,42 @@ int ipts_control_stop(struct ipts_context *ipts)
 {
 	int ret = 0;
 
+	if (!ipts)
+		return -EFAULT;
+
 	ret = _ipts_control_stop(ipts);
-	if (ret)
+
+	/*
+	 * The HID device must be gone before the module can unload, on every
+	 * path, or opening its hidraw node later runs freed module code. The
+	 * only exception is a stuck HID request or thread: then destroying the
+	 * device could block forever on locks held by the stuck task, or free
+	 * memory it still uses, and the module is pinned instead (see
+	 * ipts_remove()).
+	 */
+	if (ret == -ETIMEDOUT)
 		return ret;
 
 	ret = ipts_hid_free(ipts);
-	if (ret) {
+	if (ret)
 		dev_err(ipts->dev, "Failed to free HID device: %d\n", ret);
-		return ret;
-	}
 
 	return 0;
 }
 
-int ipts_control_restart(struct ipts_context *ipts)
+static void ipts_control_restart_work(struct work_struct *work)
 {
 	int ret = 0;
+	struct ipts_context *ipts = container_of(work, struct ipts_context, restart_work);
+
+	mutex_lock(&ipts->ctl_lock);
+
+	if (READ_ONCE(ipts->removing) || ipts->wedged || ipts->callers_stuck)
+		goto out;
 
 	ret = _ipts_control_stop(ipts);
-	if (ret)
-		return ret;
+	if (ret || READ_ONCE(ipts->mei.lock_lost) || READ_ONCE(ipts->removing))
+		goto out;
 
 	/*
 	 * Wait a second to give the sensor time to fully shut down.
@@ -480,7 +564,32 @@ int ipts_control_restart(struct ipts_context *ipts)
 
 	ret = ipts_control_start(ipts);
 	if (ret)
-		return ret;
+		dev_err(ipts->dev, "Failed to restart IPTS: %d\n", ret);
+
+out:
+	mutex_unlock(&ipts->ctl_lock);
+}
+
+void ipts_control_init(struct ipts_context *ipts)
+{
+	mutex_init(&ipts->ctl_lock);
+	INIT_WORK(&ipts->restart_work, ipts_control_restart_work);
+	atomic_set(&ipts->hid_users, 0);
+	init_waitqueue_head(&ipts->hid_users_wq);
+}
+
+int ipts_control_restart(struct ipts_context *ipts)
+{
+	if (!ipts)
+		return -EFAULT;
+
+	/*
+	 * Called from a HID callback, which stopping waits for, so the restart
+	 * itself runs from a work item, serialized with remove.
+	 */
+	if (READ_ONCE(ipts->removing))
+		return -ENODEV;
 
+	schedule_work(&ipts->restart_work);
 	return 0;
 }
