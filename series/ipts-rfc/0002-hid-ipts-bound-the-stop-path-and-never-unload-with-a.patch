@@ -8,6 +8,7 @@
 #ifndef IPTS_CONTEXT_H
 #define IPTS_CONTEXT_H
 
+#include <linux/atomic.h>
 #include <linux/completion.h>
 #include <linux/device.h>
 #include <linux/hid.h>
@@ -15,6 +16,8 @@
 #include <linux/mutex.h>
 #include <linux/sched.h>
 #include <linux/types.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
 
 #include "mei.h"
 #include "resources.h"
@@ -43,6 +46,36 @@ struct ipts_context {
 	bool hid_active;
 	struct hid_device *hid;
 
+	/*
+	 * Number of HID callbacks (requests from userspace) currently running
+	 * driver code. Stopping waits, bounded, for this to drop to 0.
+	 */
+	atomic_t hid_users;
+	wait_queue_head_t hid_users_wq;
+
+	/*
+	 * Serializes start/stop/restart. Restarts requested from a HID callback
+	 * (EDS1 mode switch) run from restart_work, never inside the callback.
+	 */
+	struct mutex ctl_lock;
+	struct work_struct restart_work;
+	bool removing;
+
+	/*
+	 * Set when stopping could not finish: the receiver thread is alive but
+	 * stuck (wedged), or a HID callback never returned (callers_stuck, its
+	 * task most likely died holding HID core locks). Nothing they can still
+	 * touch is freed, and the HID device is not destroyed.
+	 */
+	bool wedged;
+	bool callers_stuck;
+
+	/*
+	 * The receiver thread died without telling the device to stop, so the
+	 * device may still write to the data buffers: they are never freed.
+	 */
+	bool leak_buffers;
+
 	struct ipts_device_info info;
 	struct ipts_resources resources;
 
