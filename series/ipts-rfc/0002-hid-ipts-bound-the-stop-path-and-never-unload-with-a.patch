 /**
- * ipts_control_restart() - Stops the device and starts it again.
+ * ipts_control_restart() - Schedules a stop and start of the device.
  * @ipts: The IPTS driver context.
  *
- * Returns: 0 on success, <0 on error.
+ * Returns: 0 if the restart was scheduled, <0 on error.
  */
 int ipts_control_restart(struct ipts_context *ipts);
 
+/**
+ * ipts_control_init() - Initializes the locks and work items of the context.
+ * @ipts: The IPTS driver context.
+ */
+void ipts_control_init(struct ipts_context *ipts);
+
 #endif /* IPTS_CONTROL_H */
diff --git a/drivers/hid/ipts/eds2.c b/drivers/hid/ipts/eds2.c
index 6399407..15435d4 100644
--- a/drivers/hid/ipts/eds2.c
+++ b/drivers/hid/ipts/eds2.c
@@ -67,6 +67,16 @@ static int ipts_eds2_get_feature(struct ipts_context *ipts, u8 *buffer, size_t s
 	memset(&ipts->feature_report, 0, sizeof(ipts->feature_report));
 	reinit_completion(&ipts->feature_event);
 
+	/*
