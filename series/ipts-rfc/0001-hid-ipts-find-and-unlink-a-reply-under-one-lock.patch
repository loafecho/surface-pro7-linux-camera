From c3f6adad46fae9d76b5d1e7b03ac4d25fc8d186f Mon Sep 17 00:00:00 2001
From: Tony Garcia <180770769+loafecho@users.noreply.github.com>
Date: Tue, 27 Oct 2026 04:25:02 +0000
Subject: [RFC PATCH 1/2] hid: ipts: find and unlink a reply under one lock

ipts_mei_search() looked up a reply under the read side of message_lock,
dropped it, and then deleted the entry under a separately taken write
lock. Two waiters for the same command code (the receiver thread and a
HID request from userspace, both waiting for a FEEDBACK reply) can find
the same entry; the second list_del() then faults on the poisoned list
pointers (general protection fault, 0xdead000000000108, RIP
ipts_mei_search) while it holds message_lock for write. Every later user
of the lock, and every later stop of the driver, then waits forever.

Find and unlink the entry under one write lock.

Reproducer: reload the driver while four processes send HID feature
requests to its hidraw node during start-up (ipts-race.sh). Unpatched,
the driver faulted in the first cycle in 4 of 4 runs on a Surface Pro 7.

This is the same fix as linux-surface/kernel PR #178.

Fixes: 8e40dfbbf0da ("hid: Add support for Intel Precise Touch and Stylus")
Link: https://github.com/linux-surface/kernel/pull/178
Assisted-by: LLM
Patchset: ipts
---
 drivers/hid/ipts/mei.c | 42 ++++++++++++++++++------------------------
 1 file changed, 18 insertions(+), 24 deletions(-)

diff --git a/drivers/hid/ipts/mei.c b/drivers/hid/ipts/mei.c
index 1e0395c..f53cd59 100644
--- a/drivers/hid/ipts/mei.c
+++ b/drivers/hid/ipts/mei.c
@@ -26,13 +26,6 @@ static void locked_list_add(struct list_head *new, struct list_head *head,
 	up_write(lock);
 }
 
-static void locked_list_del(struct list_head *entry, struct rw_semaphore *lock)
-{
-	down_write(lock);
-	list_del(entry);
-	up_write(lock);
-}
-
 static void ipts_mei_incoming(struct mei_cl_device *cldev)
 {
 	ssize_t ret = 0;
@@ -78,6 +71,7 @@ static int ipts_mei_search(struct ipts_mei *mei, enum ipts_command_code code,
 			   struct ipts_response *rsp)
 {
 	struct ipts_mei_message *entry = NULL;
+	struct ipts_mei_message *found = NULL;
 
 	if (!mei)
 		return -EFAULT;
@@ -85,33 +79,33 @@ static int ipts_mei_search(struct ipts_mei *mei, enum ipts_command_code code,
 	if (!rsp)
 		return -EFAULT;
 
-	down_read(&mei->message_lock);
-
 	/*
 	 * Iterate over the list of received messages, and check if there is one
-	 * matching the requested command code.
+	 * matching the requested command code. The message is taken off the list
+	 * under the same write lock that found it: two waiters for the same command
+	 * code (the poll thread and a HID request from userspace) must never both
+	 * get the same entry, or the second list_del() faults on the poisoned
+	 * pointers while it holds the lock.
 	 */
+	down_write(&mei->message_lock);
+
 	list_for_each_entry(entry, &mei->messages, list) {
-		if (entry->rsp.cmd == code)
+		if (entry->rsp.cmd == code) {
+			found = entry;
+			list_del(&entry->list);
 			break;
+		}
 	}
 
-	up_read(&mei->message_lock);
+	up_write(&mei->message_lock);
 
-	/*
-	 * If entry is not the list head, this means that the loop above has been stopped early,
-	 * and that we found a matching element. We drop the message from the list and return it.
-	 */
-	if (!list_entry_is_head(entry, &mei->messages, list)) {
-		locked_list_del(&entry->list, &mei->message_lock);
+	if (!found)
+		return -EAGAIN;
 
-		*rsp = entry->rsp;
-		devm_kfree(&mei->cldev->dev, entry);
+	*rsp = found->rsp;
+	devm_kfree(&mei->cldev->dev, found);
 
-		return 0;
-	}
-
-	return -EAGAIN;
+	return 0;
 }
 
 int ipts_mei_recv(struct ipts_mei *mei, enum ipts_command_code code, struct ipts_response *rsp,
-- 
